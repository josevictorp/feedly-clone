{
  "name": "@feedly/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Feedly clone server: API, feed scheduler and static hosting.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build && node ./scripts/copy-migrations.mjs",
    "dev": "node --watch src/index.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@feedly/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "feedsmith": "^2.9.6",
    "hono": "^4.13.8",
    "pino": "^10.0.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10"
  }
}
